---
// 404.astro — GitHub Pages serves dist/404.html for any path that doesn't exist.
import BaseLayout from '../layouts/BaseLayout.astro';
import { TWINS } from '../data/site';
---
<BaseLayout title="Page not found" description="That page doesn't exist on iremitwins.com.">
  <section class="container section">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p class="lede">The link may be old, or the page may have moved when the site was rebuilt. Try one of these instead.</p>
    <div class="btn-row">
      <a class="btn btn--accent" href="/">Home</a>
      <a class="btn" href="/nika">{TWINS.nika.name}</a>
      <a class="btn" href="/gio">{TWINS.gio.name}</a>
      <a class="btn" href="/blog">Blog</a>
    </div>
  </section>
</BaseLayout>
