---
// The Godot web export lives untouched at public/first-3d-game/ (re-export over it to update).
// It only loads after "Play" is pressed, because the engine download is ~38 MB.
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="First 3D game" description="A work-in-progress 3D game made in Godot by Nika. So far: a mage who walks, runs, jumps and throws fireballs." twin="nika">
  <section class="container section--tight">
    <p class="eyebrow">Games</p>
    <h1 class="title">First 3D game</h1>
    <p><a href="/nika/games">← All games</a></p>
    <p class="muted">A work in progress, built one feature at a time in Godot. So far: a mage who walks, runs, jumps and throws fireballs at a stack of crates. Needs a keyboard and mouse. The game is a ~38 MB download, so it only loads when you press Play.</p>
    <div class="stage card" data-stage>
      <button class="btn btn--accent play" type="button" data-play>▶ Play</button>
    </div>
    <p class="muted small">WASD or arrow keys to move, Shift to run, Space to jump, left click or F for a fireball. Click the game once to look around with the mouse; Esc frees it. Mage model by <a href="https://www.kaylousberg.com">Kay Lousberg</a> (KayKit, CC0).</p>
    <p><a href="/first-3d-game/">Open full screen ↗</a></p>
  </section>
</BaseLayout>
<script>
  document.querySelector('[data-play]')?.addEventListener('click', () => {
    const stage = document.querySelector('[data-stage]')!;
    const f = document.createElement('iframe');
    f.src = '/first-3d-game/';
    f.title = 'First 3D game';
    f.allow = 'fullscreen';
    stage.replaceChildren(f);
    f.focus();
  });
</script>
<style>
  .title { font-size: clamp(2rem, 4vw, 2.8rem); }
  .stage { margin: 24px 0 16px; padding: 0; overflow: hidden; aspect-ratio: 16 / 9; max-height: 78vh; display: grid; place-items: center; background: var(--accent-soft); }
  .stage :global(iframe) { width: 100%; height: 100%; border: 0; }
  .play { font-size: 1.2rem; min-height: 56px; padding-inline: 28px; }
  .small { font-size: 0.95rem; }
</style>
