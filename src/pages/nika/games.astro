---
// The Godot export lives untouched at public/FlappyBird/ (old links keep working).
// It only loads after "Play" is pressed, because the engine download is ~38 MB.
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Flappy Bird clone" description="A Flappy Bird clone made in Godot by Nika." twin="nika">
  <section class="container section--tight">
    <p class="eyebrow">Games</p>
    <h1 class="title">Flappy Bird clone</h1>
    <p class="muted">Made in Godot. Click, tap or press space to flap. The game is a ~38 MB download, so it only loads when you press Play.</p>
    <div class="stage card" data-stage>
      <button class="btn btn--accent play" type="button" data-play>▶ Play</button>
    </div>
    <p><a href="/FlappyBird/FlappyBird.html">Open full screen ↗</a></p>
  </section>
</BaseLayout>
<script>
  document.querySelector('[data-play]')?.addEventListener('click', () => {
    const stage = document.querySelector('[data-stage]')!;
    const f = document.createElement('iframe');
    f.src = '/FlappyBird/FlappyBird.html';
    f.title = 'Flappy Bird clone';
    f.allow = 'autoplay; fullscreen';
    stage.replaceChildren(f);
    f.focus();
  });
</script>
<style>
  .title { font-size: clamp(2rem, 4vw, 2.8rem); }
  .stage { margin: 24px 0 16px; padding: 0; overflow: hidden; aspect-ratio: 9 / 14; max-height: 78vh; max-width: 520px; display: grid; place-items: center; background: var(--accent-soft); }
  .stage :global(iframe) { width: 100%; height: 100%; border: 0; }
  .play { font-size: 1.2rem; min-height: 56px; padding-inline: 28px; }
</style>
