---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';
const posts = await getPosts();
const tags = [...new Set(posts.map((p) => p.data.tag))];
---
<BaseLayout title="Blog" description="Notes, updates and the occasional rant from the Iremi twins.">
  <section class="container section">
    <p class="eyebrow">Blog</p>
    <h1>Notes from both of us</h1>
    <p class="lede">Posts are tagged by who wrote them. Subscribe with <a href="/rss.xml">RSS</a>.</p>
    <div class="filters" role="group" aria-label="Filter by tag">
      <button class="chip" aria-pressed="true" data-tag="all">All</button>
      {tags.map((t) => <button class="chip" aria-pressed="false" data-tag={t}>{t}</button>)}
    </div>
    <div class="grid grid--2 list">
      {posts.map((p) => <div data-post-tag={p.data.tag}><PostCard post={p} /></div>)}
    </div>
  </section>
</BaseLayout>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-post-tag]').forEach((el) => {
      el.hidden = b.dataset.tag !== 'all' && el.dataset.postTag !== b.dataset.tag;
    });
  }));
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 28px; }
  .filters .chip { cursor: pointer; min-height: 36px; padding-inline: 14px; font-size: 0.85rem; color: var(--ink); }
  .filters .chip[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .list > div > :global(.card) { height: 100%; }
</style>
