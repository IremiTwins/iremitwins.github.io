---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, fmtDate, postTwin } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const twin = postTwin(post.data.tag) ?? undefined;
---
<BaseLayout title={post.data.title} description={post.data.description || post.data.title} twin={twin}>
  <article class="container section">
    <p class="eyebrow"><a href="/blog">Blog</a> · {post.data.tag}</p>
    <h1>{post.data.title}</h1>
    <p class="muted mono"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time></p>
    <div class="prose"><Content /></div>
    <nav class="pager" aria-label="More posts">
      {older ? <a class="card" href={`/blog/${older.id}`}><span class="muted mono">← Older</span><br />{older.data.title}</a> : <span />}
      {newer && <a class="card right" href={`/blog/${newer.id}`}><span class="muted mono">Newer →</span><br />{newer.data.title}</a>}
    </nav>
  </article>
</BaseLayout>
<style>
  h1 { max-width: 22ch; }
  .prose { margin-top: 28px; }
  .pager { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 18px; margin-top: 56px; max-width: 70ch; }
  .pager a { font-weight: 600; }
  .right { text-align: right; }
</style>
