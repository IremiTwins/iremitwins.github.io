---
// ============================================================
// src/components/AboutSection.astro — About Cards
// ============================================================
//
// Two side-by-side card profiles, one per twin.
//
// TO ADD A THIRD PERSON: copy one of the <article> blocks below
// and update the name, role, bio, and skills. The CSS grid
// will automatically accommodate a third card.
//
// TO UPDATE SKILLS: find the .card__skills <div> inside the
// relevant card and add or remove <span> elements.
// ============================================================

// No props or data fetching — this is static content.
---

<!--
  id="about" — target for the "About" nav link (#about).
  The .section class adds consistent top/bottom padding.
-->
<section class="about section" id="about">
  <div class="container">

    <!-- ── Section label + title ────────────────────────────── -->
    <p class="section__label">// about</p>
    <h2 class="section__title">Who we are</h2>

    <!-- ── Cards grid ────────────────────────────────────────── -->
    <div class="about__cards">

      <!-- ── Card: Twin One ──────────────────────────────────── -->
      <article class="about__card card" data-animate>

        <!-- Circular avatar with image -->
        <img src="/GangsterSponge.png" alt="Twin Uno" class="card__avatar" />

        <!-- Person's name -->
        <h3>Twin Uno</h3>

        <!-- Role — shown in accent monospace font -->
        <p class="card__role">Full Stack Developer</p>

        <!-- Short bio paragraph -->
        <p>
            Senior Software Engineer focused on modern .NET client–server systems,
            high-performance device control, and rich desktop UI. Love basketball, video games,
            and all things tech. Always learning and building fun projects on the side.
        </p>
        <p> &nbsp;</p>
        <p>  
            I build gRPC/REST backends, WPF/WinUI frontends, and developer-friendly
            architectures with an emphasis on clean design, scalability, and
            pixel-perfect micro-interactions. Also exploring game development,
            Python tooling, and hardware/IoT projects on Raspberry Pi.
        </p>

        <!-- Skill badges — add/remove <span> elements here -->
        <div class="card__skills">
          <span>C#</span>
          <span>.NET 8</span>
          <span>WPF</span>
          <span>WinUI</span>
          <span>gRPC</span>
          <span>REST APIs</span>
          <span>Desktop Architecture</span>
          <span>MVVM</span>
          <span>Python</span>
          <span>PyGame</span>
          <span>Docker</span>
          <span>GitHub Actions</span>
          <span>Raspberry Pi</span>
          <span>UI/UX Systems</span>
        </div>

      </article>

      <!-- ── Card: Twin Two ──────────────────────────────────── -->
      <article class="about__card card" data-animate>

        <img src="/PatrickUchiha.jpg" alt="Nika Iremadze" class="card__avatar" />

        <h3>Nika Iremadze</h3>

        <p class="card__role">NGS Scientist &amp; Builder</p>

        <p>
          I'm a next-generation sequencing (NGS) scientist with ~8 years in the
          field, leading sequencing operations at a genomics-technology company.
          My background is in biochemistry and molecular biology (B.S., UC San
          Diego), and I'm a co-author on several peer-reviewed papers in journals
          including <em>Cell</em> and <em>Nature Biotechnology</em>.
        </p>
        <p> &nbsp;</p>
        <p>
          Outside the lab I build things. I picked up JavaScript in high school and
          C++ in college, came back to code through Python at work, and now build
          tools, apps, and games for fun — always learning, currently deep in web
          and game development.
        </p>

        <div class="card__skills">
          <span>NGS</span>
          <span>Python</span>
          <span>pandas</span>
          <span>Molecular Biology</span>
          <span>Data Analysis</span>
          <span>Automation</span>
          <span>Web Dev</span>
        </div>

        <!-- Professional / research profiles -->
        <p class="profile-links">
          <a href="https://www.linkedin.com/in/nika-iremadze-753846128" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://scholar.google.com/citations?user=ZhZt7vkAAAAJ&amp;hl=en" target="_blank" rel="noopener">Google Scholar</a>
          <a href="https://orcid.org/0000-0002-4977-204X" target="_blank" rel="noopener">ORCID</a>
        </p>

      </article>

    </div>
  </div>
</section>

<style>
  /* Research / professional profile links under the Twin Two card */
  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.25rem;
  }
  .profile-links a {
    font-family: var(--font-mono, monospace);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--clr-accent, #6c63ff);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .profile-links a:hover {
    color: var(--clr-accent-lt, #8b85ff);
    border-bottom-color: currentColor;
  }
</style>
