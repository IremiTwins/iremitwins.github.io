---
// Header.astro — site-wide top bar + (inside a twin section) that twin's sub-nav.
import { MAIN_NAV, TWINS, type TwinId } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props { twin?: TwinId }
const { twin } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const sub = twin ? TWINS[twin].nav : null;
---
<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label="Iremi Twins home">
      <span class="logo__mark" aria-hidden="true"><span>A</span><span>C</span><span>G</span><span>T</span></span>
      <span class="logo__word">iremi<b>twins</b></span>
    </a>
    <nav aria-label="Main">
      <ul class="main-nav">
        {MAIN_NAV.map((item) => (
          <li>
            <a href={item.href} data-twin={item.twin} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
  {sub && (
    <nav class="sub-nav" aria-label={`${TWINS[twin!].name}'s pages`} data-twin={twin}>
      <ul class="container">
        {sub.map((item) => (
          <li>
            <a href={item.href} aria-current={(item.href === `/${twin}` ? path === item.href : isActive(item.href)) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 2px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 16px; min-height: 64px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
  .logo__mark { display: grid; grid-template-columns: repeat(2, 14px); gap: 2px; }
  .logo__mark span {
    width: 14px; height: 14px; border-radius: 3px; display: grid; place-items: center;
    font: 600 9px/1 var(--font-mono); color: var(--paper);
  }
  .logo__mark span:nth-child(1) { background: var(--nika); }
  .logo__mark span:nth-child(2) { background: var(--gio); }
  .logo__mark span:nth-child(3) { background: var(--sun); color: #1d1a16; }
  .logo__mark span:nth-child(4) { background: var(--ink); }
  .logo__word { font-family: var(--font-display); font-size: 1.3rem; font-weight: 500; letter-spacing: -0.01em; }
  .logo__word b { font-weight: 800; }

  .main-nav { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .main-nav a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 6px 12px;
    font-weight: 600; text-decoration: none; border-radius: 999px; border: 2px solid transparent;
  }
  .main-nav a:hover { border-color: var(--line); color: var(--ink); }
  .main-nav a[aria-current='page'] { border-color: var(--line); background: var(--accent-soft); }
  .main-nav a[data-twin='nika'][aria-current='page'] { background: var(--nika-soft); }
  .main-nav a[data-twin='gio'][aria-current='page'] { background: var(--gio-soft); }

  .sub-nav { border-top: 1.5px solid var(--rule); }
  .sub-nav ul {
    display: flex; gap: 2px; list-style: none; margin-block: 0; padding-block: 6px;
    overflow-x: auto; scrollbar-width: none;
  }
  .sub-nav a {
    display: inline-flex; align-items: center; min-height: 36px; padding: 4px 12px; white-space: nowrap;
    font-family: var(--font-mono); font-size: 0.85rem; text-decoration: none; border-radius: 8px;
  }
  .sub-nav a:hover { background: var(--accent-soft); color: var(--ink); }
  .sub-nav a[aria-current='page'] { background: var(--accent); color: var(--paper); }

  @media (max-width: 560px) {
    .logo__word { display: none; }
    .main-nav a { padding: 6px 10px; }
  }
</style>
