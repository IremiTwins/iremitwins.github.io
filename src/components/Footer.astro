---
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot">
    <div>
      <p class="foot__big">Built by two brothers who should probably be sleeping.</p>
      <p class="muted small">© {year} Iremi Twins · Views are our own, not our employers'.</p>
    </div>
    <ul class="foot__links">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.github}>GitHub</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="/blog">Blog</a></li>
    </ul>
  </div>
</footer>
<style>
  .site-footer { border-top: 2px solid var(--line); background: var(--paper-2); margin-top: 64px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; padding-block: 40px; }
  .foot__big { font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 6px; }
  .small { font-size: 0.9rem; margin: 0; }
  .foot__links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; }
  .foot__links a { font-weight: 600; display: inline-block; padding-block: 8px; }
</style>
