---
// ============================================================
// src/components/PortfolioSection.astro — Project Cards
// ============================================================
//
// A grid of project showcase cards.
//
// TO ADD A NEW PROJECT:
//   1. Copy one of the <article class="project-card card"> blocks.
//   2. Update the type (e.g. "Web App"), title, description,
//      GitHub link, live site link, and tech stack badges.
//   3. If there's no live link or GitHub link, remove that <a>.
//
// TO MARK A PROJECT AS "COMING SOON":
//   Set the type to "Coming Soon" and remove the links block.
// ============================================================

// No props or data fetching — static content.
---

<!--
  id="portfolio" — target for the "Portfolio" nav link.
-->
<section class="portfolio section" id="portfolio">
  <div class="container">

    <!-- ── Section label + title ────────────────────────────── -->
    <p class="section__label">// portfolio</p>
    <h2 class="section__title">Things we've <span class="highlight">built</span></h2>

    <!-- ── Projects grid ───────────────────────────────────────
         CSS auto-fill grid — each card is at least 300px wide.
         Adds a third column on wide screens automatically.     -->
    <div class="portfolio__grid">

      <!-- ── Project: Sample Sheet Generator ───────────────────
           A real, domain-specific tool (Twin 2). No public repo
           link by choice — described, not linked.              -->
      <article class="project-card card" data-animate>

        <div class="project-card__header">
          <span class="project-card__type">Desktop App</span>
          <div class="project-card__links"></div>
        </div>

        <h3>Sample Sheet Generator</h3>

        <p>A desktop tool for generating and validating next-generation sequencing
           sample sheets — barcode auto-fill, real-time duplicate detection,
           spreadsheet import, live validation, and one-click export. Built in
           Python with a clean, unit-tested core.</p>

        <div class="project-card__tech">
          <span>Python</span>
          <span>CustomTkinter</span>
          <span>CSV</span>
        </div>

      </article>

      <!-- ── Project: This Website ─────────────────────────── -->
      <article class="project-card card" data-animate>

        <div class="project-card__header">
          <span class="project-card__type">Portfolio Site</span>
          <div class="project-card__links">
            <!-- Real links for this project -->
            <a href="https://github.com/IremiTwins/iremitwins.github.io" aria-label="View source on GitHub" target="_blank" rel="noopener">&#123;&#125;</a>
            <a href="https://iremitwins.com" aria-label="Open live site" target="_blank" rel="noopener">↗</a>
          </div>
        </div>

        <h3>This Website</h3>
        <p>Our own portfolio site — built with Astro, vanilla CSS, and a sprinkle of JS.</p>

        <div class="project-card__tech">
          <span>Astro</span>
          <span>HTML</span>
          <span>CSS</span>
          <span>JavaScript</span>
        </div>

      </article>

    </div>
  </div>
</section>
