---
// BaseLayout.astro — every page is wrapped in this.
// Props:
//   title, description — for the browser tab and search/social previews
//   twin   — 'nika' | 'gio' themes the page with that twin's accent + sub-nav
//   jsonLd — optional structured data object for search engines
//   head   — optional extra <meta> tags (e.g. citation_* for papers)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, type TwinId } from '../data/site';

interface Props {
  title: string;
  description?: string;
  twin?: TwinId;
  jsonLd?: Record<string, unknown>;
  wide?: boolean;
}
const { title, description = SITE.description, twin, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/Iremi.ico" />
    <link rel="alternate" type="application/rss+xml" title="Iremi Twins blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f6f1e7" />
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- apply saved theme before paint (avoids a flash) -->
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body data-twin={twin}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header twin={twin} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
